      "fast-xml-parser": "^5.12.0",
      "lucide-react": "^1.70.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "recharts": "^3.10.1",
      "shadcn": "^4.23.0",
