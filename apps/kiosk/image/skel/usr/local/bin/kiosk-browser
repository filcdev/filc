#!/bin/sh
# Launches the kiosk SPA fullscreen in Chromium under cage. The box identifies
# itself by its DMI product UUID; the SPA origin comes from /etc/kiosk/url so a
# box can be repointed by editing one file.
set -eu

: "${HOME:=/home/kiosk}"
export HOME

machine_id=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
if [ -z "$machine_id" ]; then
    # Some boards report an empty (or duplicated) UUID; fall back to the first
    # non-loopback MAC address, which is stable for a given box.
    LC_ALL=C
    export LC_ALL
    for address in /sys/class/net/*/address; do
        case "$address" in
            */lo/address) continue ;;
        esac
        mac=$(cat "$address" 2>/dev/null || true)
        if [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
            machine_id=$mac
            break
        fi
    done
fi
if [ -z "$machine_id" ]; then
    echo 'kiosk-browser: no machine id (no DMI product UUID, no usable MAC)' >&2
    exit 1
fi

profile_dir=/tmp/kiosk/chromium
install -d -m 0700 "$profile_dir/Default"
# Pre-seed the "never translate" preference: the feature flags are not enough on
# every Chromium version, and the profile lives on tmpfs, so it is re-seeded on
# every boot instead of being migrated.
printf '%s' '{"translate":{"enabled":false,"blocked_languages":["hu"],"denied_count":999}}' \
    > "$profile_dir/Default/Preferences"

url=$(cat /etc/kiosk/url)

# Flag set reviewed against the Chromium in `packages` (152.0.7977.82):
#   --ozone-platform=x11: Chromium's kiosk mode does not hide its own UI under
#     Wayland -- the box would show a tab strip and an omnibox -- while the X11
#     path through the Xwayland cage already starts gives a chromeless, full
#     screen window. cage exports DISPLAY, so Chromium finds it without help.
#   --disable-translate and --disable-session-crashed-bubble no longer exist in
#     this Chromium (the replacement for the latter is --hide-crash-restore-bubble).
#   --use-gl=swiftshader is gone too: software GL is selected through ANGLE
#     (--use-angle=swiftshader), and --enable-unsafe-swiftshader is what permits
#     software WebGL at all.
exec chromium \
    --kiosk \
    --ozone-platform=x11 \
    --start-maximized \
    --noerrdialogs \
    --no-first-run \
    --hide-crash-restore-bubble \
    --disable-infobars \
    --password-store=basic \
    --disable-features=Translate,TranslateUI,LanguageDetection \
    --disable-popup-blocking \
    --disable-notifications \
    --disable-default-apps \
    --disable-extensions \
    --disable-sync-preferences \
    --disable-background-mode \
    --disable-new-tab-first-run \
    --disable-crash-reporter \
    --disable-dev-shm-usage \
    --hide-scrollbars \
    --mute-audio \
    --memory-pressure-off \
    --force-device-scale-factor=1 \
    --enable-unsafe-swiftshader \
    --use-angle=swiftshader \
    --enable-gpu-rasterization \
    --lang=hu \
    --user-data-dir="$profile_dir" \
    "${url%/}/?machine=$machine_id"
