CHRONOS_LOG_LEVEL=debug
CHRONOS_BASE_URL=http://localhost:3000
CHRONOS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# --------------------------------------------------
# | You have to change every value below this line |
# --------------------------------------------------
CHRONOS_AUTH_SECRET=FILL_ME_IN
CHRONOS_ADMIN_EMAIL=your.email.here@petrik.hu
CHRONOS_ENTRA_TENANT_ID=FILL_ME_IN
CHRONOS_ENTRA_CLIENT_ID=FILL_ME_IN
# Not needed where CHRONOS_OAUTH_PROXY_URL points at another origin: that
# preview hands the code exchange to the proxy origin.
CHRONOS_ENTRA_CLIENT_SECRET=FILL_ME_IN

# --------------------------------------------------
# | OAuth proxy (preview deployments) - Optional   |
# --------------------------------------------------
# Entra rejects wildcard redirect URIs, so a preview served on its own hostname
# cannot complete a sign-in by itself. With both values set, previews start the
# flow against the production origin, production exchanges the code and hands an
# encrypted profile back, and the preview creates the session in its own
# database. Production itself is an origin match, so it is unaffected.
#
# Set both in every environment that should authenticate; the secret must be
# identical everywhere (openssl rand -base64 32). Leave them unset to disable
# the plugin entirely. See docs/entra-setup.md.
#
# A proxied environment (a preview) is the only one that may leave
# CHRONOS_ENTRA_CLIENT_SECRET unset.
# CHRONOS_OAUTH_PROXY_URL=https://filc.petrik.hu
# CHRONOS_OAUTH_PROXY_SECRET=

# --------------------------------------------------
# | Server                                         |
# --------------------------------------------------
# HTTP port the API binds (default: 3001)
# CHRONOS_PORT=3001

# development | production. Any non-production value makes error responses
# carry the underlying message and cause (default: development)
# CHRONOS_MODE=development

# Log every SQL statement at trace level (default: false)
# CHRONOS_DRIZZLE_DEBUG=false

# --------------------------------------------------
# | Telemetry (Sentry) - Optional but recommended |
# --------------------------------------------------
# Sentry DSN for error tracking
# CHRONOS_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Environment name (defaults to CHRONOS_MODE value)
# CHRONOS_SENTRY_ENVIRONMENT=development

# Release version (defaults to package version)
# CHRONOS_SENTRY_RELEASE=chronos@1.0.0

# Error sampling rate (1.0 = 100%, 0.1 = 10%)
# CHRONOS_SENTRY_SAMPLE_RATE=1.0

# Performance tracing sample rate (0.1 = 10% recommended for production)
# CHRONOS_SENTRY_TRACES_SAMPLE_RATE=0.1

# --------------------------------------------------
# | Notification system                              |
# --------------------------------------------------
# SMTP delivery for the Mailpit service in the local dev compose stack
# (see compose.yml — web UI http://localhost:8025, SMTP localhost:1025).
# Leave the block commented when using pg-dispo without Mailpit: with no SMTP
# host configured, Chronos disables email delivery instead of failing sends.
# Uncomment it when running the compose stack:
# CHRONOS_SMTP_HOST=localhost
# CHRONOS_SMTP_PORT=1025
# CHRONOS_SMTP_USER=
# CHRONOS_SMTP_PASS=
# CHRONOS_SMTP_FROM_NAME=Filc
# CHRONOS_SMTP_FROM_EMAIL=noreply@filc.hu
# CHRONOS_SMTP_SECURE=false

# Firebase Cloud Messaging for push notifications
# CHRONOS_FCM_CREDENTIALS={"type":"service_account",...}
# CHRONOS_FCM_PROJECT_ID=your-firebase-project-id

# Notification delays in seconds (wait period before sending)
# CHRONOS_NOTIFICATION_DELAY_SUBSTITUTION=60
# CHRONOS_NOTIFICATION_DELAY_MOVED_LESSON=60
# CHRONOS_NOTIFICATION_DELAY_ANNOUNCEMENT=60
# CHRONOS_NOTIFICATION_DELAY_SYSTEM_MESSAGE=60
# CHRONOS_NOTIFICATION_DELAY_BLOG_POST=60

# Delay before a cohort-reselection notice is sent in seconds (default: 0)
# CHRONOS_NOTIFICATION_DELAY_COHORT_RESELECTION_REQUIRED=0

# --------------------------------------------------
# | Rate limiting                                  |
# --------------------------------------------------
# Maximum requests per window per client (default: 180)
# CHRONOS_RATE_LIMIT_MAX=180

# Rate limit window in milliseconds (default: 30000 = 30 seconds)
# CHRONOS_RATE_LIMIT_WINDOW_MS=30000

# Cookie name for anonymous client identification (default: filc_rl_id)
# CHRONOS_RATE_LIMIT_COOKIE_NAME=filc_rl_id

# Header to read the real client IP from (e.g. X-Forwarded-For, CF-Connecting-IP)
# CHRONOS_REAL_IP_HEADER=X-Forwarded-For

# --------------------------------------------------
# | Wi-Fi / FreeRADIUS (optional)                  |
# --------------------------------------------------
# CHRONOS_WIFI_ENABLED=true
# CHRONOS_WIFI_SSID="Filc WiFi"
# The RADIUS endpoint fails closed unless the shared secret and source IP are configured.
# CHRONOS_FREERADIUS_IP=172.18.1.2
# CHRONOS_FREERADIUS_SHARED_SECRET=FILL_ME_IN
# CHRONOS_WIFI_ENCRYPTION_SECRET=FILL_ME_IN
# Relative or absolute path to ca.pem or the directory containing it (e.g. ../radius/certs/ca.pem or ../radius/certs)
# CHRONOS_WIFI_CA_CERT_PATH=../radius/certs/ca.pem
# CHRONOS_WIFI_CONTROLLER_PROVIDER=none

# Set the provider to unifi to enable controller enrichment and speed profiles.
# UNIFI_HOST=unifi.example.com

# Disable TLS certificate verification, unfortunately not possible to do this scoped to specific fetches, so this is a global setting. Only use this if you know what you're doing.
# It's recommended to use a valid TLS certificate instead of disabling verification. Or trusting the self-signed certificate in your system's trust store. This is only needed if you are using a self-signed certificate on your Unifi controller.
# UNIFI_INSECURE_TLS=false

# UNIFI_PORT=8443
# UNIFI_USERNAME=
# UNIFI_PASSWORD=

# Origins allowed to call the API from a browser, comma-separated (besides
# CHRONOS_BASE_URL, which is always allowed). The kiosk build is static and
# talks to the API by absolute URL, so its own origin belongs here.
# CHRONOS_TRUSTED_ORIGINS=https://kiosk.filc.petrik.hu

# --------------------------------------------------
# | Kiosk public data (optional)                   |
# --------------------------------------------------
# WeatherAPI key behind GET /api/kiosk/weather. Without it that endpoint
# answers 502 and the TV page hides the weather box.
# CHRONOS_WEATHER_API_KEY=your-weatherapi-key
#
# Location the kiosk weather is queried for, as "lat,lon" (default: the school)
# CHRONOS_KIOSK_WEATHER_LOCATION=47.50535837979173,19.090123083749727
#
# BKK Futǭr API key behind POST /api/kiosk/departures. Without it that endpoint
# answers 502 and the TV page hides its departure cards.
# CHRONOS_BKK_API_KEY=your-bkk-futar-key

# --------------------------------------------------
# | Object storage (Garage, S3 API) - Optional     |
# --------------------------------------------------
# Storage for announcement images (compose.yml runs Garage locally; the
# credentials are its GARAGE_DEFAULT_* values). Optional: without these,
# announcement image uploads are refused and stored images cannot be served.
# CHRONOS_S3_ENDPOINT=http://localhost:3900
# CHRONOS_S3_REGION=garage
# CHRONOS_S3_BUCKET=filc-dev
# CHRONOS_S3_ACCESS_KEY_ID=
# CHRONOS_S3_SECRET_ACCESS_KEY=
