{
  "name": "@filcdev/chronos",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:seed": "bun run ./src/database/scripts/seed.ts",
    "db:import-navigator": "bun --bun src/database/scripts/import-navigator.ts",
    "db:reset": "bun run ./src/database/scripts/reset.ts",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@filcdev/api": "workspace:*",
    "@filcdev/auth": "workspace:*",
    "@filcdev/timetable-import": "workspace:*",
    "@logtape/logtape": "^2.4.0",
    "@orpc/contract": "catalog:",
    "@orpc/experimental-ratelimit": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sentry/bun": "^11.5.0",
    "better-auth": "catalog:",
    "cronbake": "^0.4.0",
    "dayjs": "catalog:",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fast-xml-parser": "catalog:",
    "firebase-admin": "^14.5.0",
    "handlebars": "^4.7.10",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "string-ts": "^2.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@logtape/pretty": "^2.4.0",
    "@openapi-spec/downgrader": "^0.3.0",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@types/cli-progress": "^3.11.6",
    "@types/nodemailer": "^8.0.2",
    "cli-progress": "^3.12.0",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "catalog:"
  },
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  }
}
