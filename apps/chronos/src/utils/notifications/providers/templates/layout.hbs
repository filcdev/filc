<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{title}}</title>
  <style>
    body {
      font-family: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #18181b;
      background: #f4f5f7;
      margin: 0;
      padding: 24px 0;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      max-width: 600px;
      width: 100%;
      margin: 0 auto;
    }
    .card {
      background: #ffffff;
      border-radius: 18px;
      box-shadow: 0 1px 3px rgba(24, 24, 27, 0.08), 0 8px 24px rgba(24, 24, 27, 0.06);
      overflow: hidden;
    }
    .header {
      background: #0d9488;
      color: #ffffff;
      padding: 28px;
    }
    .type {
      display: inline-block;
      background: rgba(255, 255, 255, 0.16);
      color: #ffffff;
      border-radius: 999px;
      padding: 4px 12px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin-bottom: 10px;
    }
    .header h1 {
      margin: 0;
      font-size: 21px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .body {
      padding: 26px 28px;
      font-size: 15px;
      color: #3f3f46;
    }
    .body p {
      margin: 0 0 16px;
    }
    .greeting {
      margin-bottom: 12px;
      color: #18181b;
      font-weight: 600;
    }
    .btn {
      display: inline-block;
      background: #0d9488;
      color: #ffffff;
      padding: 10px 24px;
      border-radius: 26px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      margin-top: 8px;
    }
    .footer {
      padding: 18px 28px;
      border-top: 1px solid #f0f0f2;
      background: #fafafa;
      font-size: 12px;
      color: #71717a;
    }
    .footer p {
      margin: 0 0 6px;
    }
    .footer p:last-child {
      margin-bottom: 0;
    }
    .footer a {
      color: #0d9488;
      text-decoration: none;
    }
    @media (max-width: 620px) {
      .container { padding: 0 12px; }
      .header, .body, .footer { padding-left: 20px; padding-right: 20px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <span class="type">{{typeLabel}}</span>
        <h1>{{title}}</h1>
      </div>
      <div class="body">
        <p class="greeting">{{greeting}}</p>
        {{> content}}
        <a href="{{baseUrl}}" class="btn">{{viewLabel}}</a>
      </div>
      <div class="footer">
        <p>{{autoMessage}}</p>
        <p><a href="{{unsubscribeUrl}}">{{unsubscribeLabel}}</a></p>
      </div>
    </div>
  </div>
</body>
</html>
